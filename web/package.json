{
  "name": "bindforge-nw",
  "version": "1.0.0",
  "private": true,
  "description": "A Neverwinter keybind builder, console-command browser, conflict planner, collection manager, and copy-ready bind-pack generator.",
  "author": "Archew",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern playwright-report --ignore-pattern test-results",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json",
    "typecheck:browser": "tsc --noEmit --pretty false -p tsconfig.playwright.json",
    "test": "node --test tests/*.test.mjs",
    "test:focused-guard": "node scripts/check-focused-tests.mjs",
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report",
    "catalog:health": "node scripts/catalog-health.mjs",
    "catalog:sources": "node scripts/catalog-source-health.mjs",
    "client:audit": "node scripts/client-boundary-audit.mjs",
    "security:audit": "npm audit --audit-level=low",
    "check": "npm run test:focused-guard && npm run lint && npm run typecheck && npm run test && npm run catalog:health && npm run client:audit && npm run build",
    "check:release": "npm run check && npm run typecheck:browser && npm run test:browser",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.112.0"
  }
}
