{
  "name": "bindforge-nw",
  "version": "1.0.0",
  "private": true,
  "description": "A Neverwinter keybind builder, console-command browser, conflict planner, collection manager, and copy-ready bind-pack generator.",
  "author": "Archew",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern playwright-report --ignore-pattern test-results",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json",
    "typecheck:browser": "tsc --noEmit --pretty false -p tsconfig.playwright.json",
    "test": "node --test tests/*.test.mjs",
    "test:focused-guard": "node scripts/check-focused-tests.mjs",
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report",
    "catalog:health": "node scripts/catalog-health.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run test:focused-guard && npm run lint && npm run typecheck && npm run test && npm run catalog:health && npm run build",
    "check:release": "npm run check && npm run typecheck:browser && npm run test:browser",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "^4.112.0"
  }
}
